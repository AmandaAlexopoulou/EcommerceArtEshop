alue="70"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="sqlite_sequence" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="101"/><column index="2" value="31"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="users" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="0" mode="0"/></sort><column_widths><column index="1" value="29"/><column index="2" value="63"/><column index="3" value="39"/><column index="4" value="62"/><column index="5" value="79"/><column index="6" value="49"/><column index="7" value="68"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- 1. Δημιουργία νέου πίνακα με UNIQUE για το email
--CREATE TABLE IF NOT EXISTS customers_new (
--    id INTEGER PRIMARY KEY AUTOINCREMENT,
--    name TEXT NOT NULL,
--    email TEXT UNIQUE NOT NULL
--);

-- 2. Αντιγραφή δεδομένων από τον παλιό πίνακα στον νέο
--INSERT INTO customers_new (id, name, email)
--SELECT id, name, email FROM customers;

-- 3. Διαγραφή του παλιού πίνακα
--DROP TABLE customers;

-- 4. Μετονομασία του νέου πίνακα
--ALTER TABLE customers_new RENAME TO customers;

CREATE TABLE IF NOT EXISTS users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    username TEXT UNIQUE NOT NULL,
    email TEXT UNIQUE NOT NULL,
    password TEXT NOT NULL,
    customer_id INTEGER NOT NULL,    -- Αναφορά στον πίνακα customers
    role_id INTEGER NOT NULL,        -- Αναφορά στον πίνακα roles
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY(customer_id) REFERENCES customers(id) ON DELETE CASCADE,  -- Σύνδεση με πελάτες
    FOREIGN KEY(role_id) REFERENCES roles(id) ON DELETE CASCADE           -- Σύνδεση με ρόλους
);
CREATE TABLE IF NOT EXISTS roles (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    role_name TEXT UNIQUE NOT NULL
);

INSERT OR IGNORE INTO roles (role_name) VALUES
('admin'),
('customer');
</sql><current_tab id="0"/></tab_sql></sqlb_project>
